<?xml version="1.0" encoding="utf-8"?>
<mujoco model="biped">

	<!-- Simulation Parameters -->
	<option timestep="0.001" iterations="15" ls_iterations="15" solver="Newton" gravity="0 0 -9.81"></option>

	<!-- Specify the light settings -->
	<visual>
		<headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
		<rgba haze="0.15 0.25 0.35 1"/>
		<global azimuth="150" elevation="-20" offwidth="720" offheight="480"/>
	</visual>

	<!-- Ground plane -->
	<asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
        markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="1 1" reflectance="0.5"/> <!-- smallest checker square is 1 meter big-->
		<material name="robot_color" rgba="1 0 0 0.5"/>
		<material name="stance_leg_color" rgba="0 1 0 0.5"/>
    </asset>  

	<!-- Set angles to be in radians -->
	<compiler angle="radian" autolimits="true" eulerseq="zyx"/>

	<!-- Bodies -->
	<worldbody>
		<!-- Ground -->
		<geom name="plane" type="plane" size="0.0 0.0 0.125" material="groundplane"  conaffinity="1" contype="1"/>

		<!-- Origin Visual -->
		<geom name="origin_sphere" type="sphere" size="0.025" pos="0 0 0" rgba="1 0 0 1" conaffinity="0" contype="0"/>
		<geom name="x_axis_origin" type="capsule" size="0.01 0.2" pos="0.2 0 0" euler="0 1.57 0" rgba="1 0 0 1" conaffinity="0" contype="0"/>
		<geom name="y_axis_origin" type="capsule" size="0.01 0.2" pos="0 0.2 0" euler="0 0 1.57" rgba="0 1 0 1" conaffinity="0" contype="0"/>
		<geom name="z_axis_origin" type="capsule" size="0.01 0.2" pos="0 0 0.2" euler="0 0 0" rgba="0 0 1 1" conaffinity="0" contype="0"/>

		<!-- COM Visual -->
		<geom name="com_vis" type="sphere" size="0.05" rgba="0 1 0 1" pos="0 1.1 0"/>
		<geom name="left_vis" type="sphere" size="0.05" rgba="0 0 1 1" pos="0 1.1 0"/>
		<geom name="right_vis" type="sphere" size="0.05" rgba="1 0 0 1" pos="0 1.1 0"/>

		<!-- Robot -->
		<body name="stance_foot" mocap="true" pos="0 0 0">
			<geom name="stance_foot" type="sphere" size="0.05" pos="0 0 0" rgba="0 1 0 1" conaffinity="0" contype="0" density="0"/>
			<body name="stance_lower_leg">
				<joint name="stance_ankle_joint" type="hinge" axis="0 1 0" pos="0 0 0" limited="true" range="-1.57 1.57" damping="0.1"/>
				<geom name="stance_lower_leg" type="capsule" size="0.05 0.25" pos="0 0 0.25" material="stance_leg_color" conaffinity="0" contype="0" />
				<inertial mass="2.0" pos="0 0 0.25" diaginertia="0.1 0.1 0.1"/> 

				<body name="stance_upper_leg" pos="0 0 0.5">
					<joint name="stance_knee_joint" type="hinge" axis="0 1 0" pos="0 0 0" limited="true" range="-1.57 1.57" damping="0.1"/>
					<geom name="stance_upper_leg" type="capsule" size="0.05 0.25" pos="0 0 0.25" material="stance_leg_color" conaffinity="0" contype="0"/>
					<inertial mass="2.0" pos="0 0 0.25" diaginertia="0.1 0.1 0.1"/>

					<body name="torso" pos="0 0 0.5">
						<joint name="stance_hip_joint" type="hinge" axis="0 1 0" pos="0 0 0" limited="true" range="-1.57 1.57" damping="0.1"/>
						<geom name="torso" type="capsule" size="0.05 0.25" pos="0 0 0.25" material="robot_color" conaffinity="0" contype="0"/>
						<inertial mass="20.0" pos="0 0 0.25" diaginertia="0.1 0.1 0.1"/>

						<body name="swing_upper_leg" pos="0 0 0">
							<!-- Swing leg upper part -->
							<joint name="swing_hip_joint" type="hinge" axis="0 1 0" pos="0 0 0" limited="true" range="-1.57 1.57" damping="0.1"/>
							<geom name="swing_upper_leg" type="capsule" size="0.05 0.25" pos="0 0 -0.25" material="robot_color" conaffinity="0" contype="0"/>
							<inertial mass="2.0" pos="0 0 -0.25" diaginertia="0.1 0.1 0.1"/>

							<!-- Swing leg lower part -->
							<body name="swing_lower_leg" pos="0 0 -0.5">
								<joint name="swing_knee_joint" type="hinge" axis="0 1 0" pos="0 0 0" limited="true" range="-3.14 3.14" damping="0.1"/>
								<geom name="swing_lower_leg" type="capsule" size="0.05 0.25" pos="0 0 -0.25" material="robot_color" conaffinity="0" contype="0"/>
								<inertial mass="2.0" pos="0 0 -0.25" diaginertia="0.1 0.1 0.1"/>
								<body name="swing_foot" pos="0 0 -0.5">
									<geom name="swing_foot" type="sphere" size="0.05" pos="0 0 0" rgba="0 1 0 1" conaffinity="0" contype="0"/>
								</body>
							</body>
						</body>

					</body>

				</body>
			</body>
		</body>

	</worldbody>

	<!-- Actuators -->
	<actuator>
		<motor name="stance_hip_motor" joint="stance_hip_joint" ctrllimited="false" gear="1"/>
    	<motor name="stance_knee_motor" joint="stance_knee_joint" ctrllimited="false" gear="1"/>
		<motor name="swing_hip_motor" joint="swing_hip_joint" ctrllimited="false" gear="1"/>
		<motor name="swing_knee_motor" joint="swing_knee_joint" ctrllimited="false" gear="1"/>
	</actuator>

</mujoco>
